ENV=development
BIND_ADDRESS=127.0.0.1
PORT=8080
# Leave empty without a reverse proxy. Never trust all Internet addresses.
TRUSTED_PROXIES=
DATABASE_URL=postgres://unstrange@127.0.0.1:55439/unstrange_dev?sslmode=disable
# Optional runtime pool endpoint. DATABASE_URL remains the direct migration endpoint.
DATABASE_URL_POOLED=
JWT_SECRET=replace-with-a-long-random-secret
# Required in production: base64-encoded random 32-byte AES key. Keep stable and secret.
PRIVATE_MEDIA_KEY=
OTP_MODE=mock
MOCK_OTP=123456
# Optional locally; required for production mock mode. Dedicated test numbers only.
MOCK_OTP_PHONES=
TEST_OTP=
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# Switch OTP_MODE to msg91 when your SMS provider is ready.
MSG91_AUTH_TOKEN=
MSG91_WIDGET_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=unstrange-assets
# Public delivery origin for every S3 upload (photos, videos, avatars, covers).
# Leave empty for direct S3 URLs. Local disk uploads still use /uploads/.
ASSET_BASE_URL=https://dt9dx2ny2cwkb.cloudfront.net

# Optional AI: explicit model choice; secrets stay on the server.
OPENAI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
REQUIRE_MODERATION=false

# Comma-separated user UUIDs, never phone numbers.
ADMIN_USER_IDS=
REQUIRE_IDENTITY_VERIFICATION=false

# Optional Open-Meteo-compatible forecast endpoint. Leave empty to disable.
WEATHER_API_URL=
