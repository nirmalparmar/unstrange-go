[Unit]
Description=Unstrange Go API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=unstrange
Group=unstrange
WorkingDirectory=/opt/unstrange
EnvironmentFile=/etc/unstrange/backend.env
Environment=ENV=production GIN_MODE=release SKIP_DOTENV=true BIND_ADDRESS=127.0.0.1 PORT=8080 TEST_OTP= TRUSTED_PROXIES=127.0.0.1/32,::1/128
ExecStart=/opt/unstrange/server
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
