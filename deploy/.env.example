# Install as /etc/unstrange/backend.env on the VM. Do not commit credentials.
ENV=production
APP_URL=https://api.example.com
FRONTEND_URL=https://example.com

# Paste your direct and pooled Neon URLs, including their TLS parameters.
DATABASE_URL=
DATABASE_URL_POOLED=

# Generate once; keep these stable across deployments and store a secure backup.
JWT_SECRET=
PRIVATE_MEDIA_KEY=
TEST_OTP=
# Provider-free preview: change to mock and list dedicated test numbers below.
# Example: MOCK_OTP_PHONES=+919999999999,+919999999998
OTP_MODE=msg91
MOCK_OTP=123456
MOCK_OTP_PHONES=

# Required only when OTP_MODE=msg91.
MSG91_AUTH_TOKEN=
MSG91_WIDGET_ID=

# Required for public photo/video uploads; private chat/identity images use Neon.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
ASSET_BASE_URL=https://dt9dx2ny2cwkb.cloudfront.net

# Optional features.
OPENAI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
REQUIRE_MODERATION=false
ADMIN_USER_IDS=
REQUIRE_IDENTITY_VERIFICATION=false
WEATHER_API_URL=
